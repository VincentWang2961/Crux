# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Host port exposed by docker compose
PORT=3000
# Admin page (/admin, reached from the hero). Server-only; never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=change-me
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`). Signs the session cookie.
ADMIN_SESSION_SECRET=
# Where availability edits are stored (defaults to ./data; the Docker image uses /app/data)
# AVAILABILITY_DATA_DIR=
